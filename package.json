{
  "name": "yu-music",
  "version": "0.1.0",
  "description": "YuMusic Electron 3D 音乐播放器",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/src/app.js --bundle --minify --outfile=renderer/app.js && esbuild renderer/src/sonnet-entry.js --bundle --minify --format=iife --outfile=renderer/sonnet.js",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "app": "dist\\YuMusic\\YuMusic.exe .",
    "start:yu": "npm run build && dist\\YuMusic\\YuMusic.exe ."
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "crypto-js": "^4.2.0",
    "iconv-lite": "^0.7.3",
    "node-forge": "^1.3.1",
    "pixi.js": "^8.19.0",
    "qrcode": "^1.5.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "esbuild": "^0.21.5"
  },
  "productName": "YuMusic"
}
